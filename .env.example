# App runtime
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# Public URLs used by browser/client
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Socket.io CORS allowed origins (comma-separated)
SOCKET_CORS_ORIGIN=http://localhost:3000

# Optional: protect admin add-image API
# Leave empty to disable key check
ADMIN_KEY=
